# PostgreSQL
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=dashboard
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Authentication
# Generate a real secret with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_value
JWT_EXPIRES_MINUTES=60

# Email verification (Gmail SMTP)
# SMTP_PASSWORD is a Google App Password, NOT your account password
# Google Account > Security > 2-Step Verification > App passwords
EMAIL_VERIFICATION=your.address@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your_16_char_password
APP_BASE_URL=http://localhost:8080
CONFIRMATION_EXPIRES_HOURS=24

# Gmail widget
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback
